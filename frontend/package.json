    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}