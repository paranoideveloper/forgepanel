# ForgePanel environment overrides — sourced by the systemd unit.
#
# Everything here is optional and commented out; the panel applies sane defaults
# and persists most settings in its own config once you use the UI. Uncomment a
# line only to pin a value, then: systemctl restart forgepanel
#
# Data directory (SQLite database, secrets, certificates). Must be writable and
# is created 0700 by the package.
#FORGEPANEL_DATA=/var/lib/forgepanel

# Listener ports.
#FORGEPANEL_PANEL_PORT=2053
#FORGEPANEL_API_PORT=2054
#FORGEPANEL_SUB_PORT=2096

# ForgeDNS authoritative listener (udp). Binding 53 needs the service to keep
# CAP_NET_BIND_SERVICE and nothing else on the host to own the port.
#FORGEPANEL_DNS_PORT=53

# Initial admin username, used only on first boot.
#FORGEPANEL_ADMIN_USER=admin

# Telegram notifications.
#FORGEPANEL_TELEGRAM_TOKEN=
#FORGEPANEL_TELEGRAM_ADMINS=
