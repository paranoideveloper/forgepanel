# ForgeEdge Bot configuration.
#
# Fill this in, then:  sudo systemctl enable --now forgeedge-bot
#
# 1) Create the bot: in Telegram, message @BotFather, send /newbot, follow the
#    prompts, and paste the token it gives you (looks like 123456789:AA…).
FORGEEDGE_BOT_TOKEN=

# 2) Your Telegram numeric id — the owner who approves everyone else.
#    Message @userinfobot; it replies with your Id.
FORGEEDGE_BOT_OWNER=

# 3) Optional: where to keep the encrypted state (credentials + master key).
#    Defaults to /var/lib/forgeedge-bot, which the service creates at 0700.
#FORGEEDGE_BOT_DATA=/var/lib/forgeedge-bot
