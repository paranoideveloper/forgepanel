{
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "tag": "socks"
    },
    {
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "tag": "http"
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "a.example.com",
            "port": 443,
            "users": [
              {
                "alterId": 0,
                "id": "11111111-2222-3333-4444-555555555555",
                "security": "auto"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "a.example.com"
        },
        "wsSettings": {
          "headers": {
            "Host": "a.example.com"
          },
          "path": "/ws"
        }
      },
      "tag": "proxy"
    },
    {
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "address": "b.example.com",
            "password": "trojanpass",
            "port": 443
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "b.example.com"
        }
      },
      "tag": "proxy-2"
    },
    {
      "protocol": "shadowsocks",
      "settings": {
        "servers": [
          {
            "address": "c.example.com",
            "method": "2022-blake3-aes-128-gcm",
            "password": "MTIzNDU2Nzg5MDEyMzQ1Ng==",
            "port": 8388
          }
        ]
      },
      "streamSettings": {
        "network": "tcp"
      },
      "tag": "proxy-3"
    },
    {
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "d.example.com",
            "port": 1080,
            "users": [
              {
                "pass": "p",
                "user": "u"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp"
      },
      "tag": "proxy-4"
    },
    {
      "protocol": "http",
      "settings": {
        "servers": [
          {
            "address": "e.example.com",
            "port": 8080,
            "users": [
              {
                "pass": "hp",
                "user": "hu"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp"
      },
      "tag": "proxy-5"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "network": "tcp,udp",
        "outboundTag": "proxy",
        "type": "field"
      }
    ]
  }
}